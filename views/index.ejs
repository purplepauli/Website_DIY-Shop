    <script>
        (function () {
            // ---------- Teil 1: echtes Endlos-Karussell ohne Rück-Sprung ----------
            //
            // Trick: Die 3 echten Kacheln werden 2x geklont, sodass insgesamt
            // 3 Kopien nebeneinander im Track liegen: [B,R,Rep, B,R,Rep, B,R,Rep].
            // Wir starten in der mittleren Kopie. Bewegt man sich über den Rand
            // der mittleren Kopie hinaus, springen wir NACH der Animation
            // (ohne Übergang) exakt eine Kopie zurück/vor – das ist unsichtbar,
            // weil an dieser Stelle exakt die gleiche Kachel liegt.
            const viewport = document.getElementById('projectCarouselViewport');
            const track = document.getElementById('projectCarouselTrack');
            const originalSlides = Array.from(track.children);
            const slideCount = originalSlides.length; // 3
            const dots = Array.from(document.querySelectorAll('#projectCarouselDots .carousel-dot'));
            const prevBtn = document.querySelector('.carousel-arrow-prev');
            const nextBtn = document.querySelector('.carousel-arrow-next');
            const carousel = document.querySelector('.project-carousel');

            const PEEK = 0;     // Kein seitliches Durchschimmern der Nachbar-Kachel mehr (0 = komplett verdeckt)
            const GAP = 20;    // Abstand zwischen den Kacheln in px
            const AUTOPLAY_MS = 7000;  // Zeit bis zum automatischen Weiterspringen
            const TRANSITION_MS = 550;  // muss zur CSS-Transition unten passen

            // Zwei zusätzliche Kopien anlegen (insgesamt 3 Kopien = 9 Slides)
            for (let copy = 0; copy < 2; copy++) {
                originalSlides.forEach(slide => {
                    const clone = slide.cloneNode(true);
                    clone.setAttribute('aria-hidden', 'true');
                    clone.querySelectorAll('a').forEach(a => a.setAttribute('tabindex', '-1'));
                    track.appendChild(clone);
                });
            }
            const slides = Array.from(track.children); // 9 Slides gesamt

            let index = slideCount; // Start: erste Kachel der mittleren Kopie
            let autoplayTimer = null;

            function slideWidth() {
                return viewport.clientWidth - PEEK * 2;
            }

            function realIndex(i) {
                return ((i % slideCount) + slideCount) % slideCount;
            }

            function render(animate) {
                const width = slideWidth();
                const offset = PEEK - index * (width + GAP);
                track.style.transition = animate ? `transform ${TRANSITION_MS}ms cubic-bezier(.4,0,.2,1)` : 'none';
                track.style.transform = `translateX(${offset}px)`;
                slides.forEach((slide, i) => slide.classList.toggle('is-active', i === index));
                const activeReal = realIndex(index);
                dots.forEach((dot, i) => dot.classList.toggle('is-active', i === activeReal));
                slides.forEach((slide, i) => {
                    slide.setAttribute('aria-hidden', i === index ? 'false' : 'true');
                });
            }

            function layout() {
                const width = slideWidth();
                slides.forEach(slide => {
                    slide.style.width = width + 'px';
                    slide.style.marginRight = GAP + 'px';
                });
                render(false);
            }

            // Nach jeder animierten Bewegung: prüfen, ob wir die mittlere
            // Kopie verlassen haben, und falls ja, unsichtbar zurückspringen.
            track.addEventListener('transitionend', (e) => {
                if (e.propertyName !== 'transform') return;
                if (index < slideCount) {
                    index += slideCount;
                    render(false);
                } else if (index >= slideCount * 2) {
                    index -= slideCount;
                    render(false);
                }
            });

            function step(delta) {
                index += delta;
                render(true);
                restartAutoplay();
            }

            function goToReal(target) {
                const current = realIndex(index);
                let diff = (target - current + slideCount) % slideCount;
                if (diff === 0) return;
                // kürzesten Weg wählen (bei 3 Kacheln immer 1 Schritt vor oder zurück)
                if (diff === 1) {
                    step(1);
                } else {
                    step(-1);
                }
            }

            function restartAutoplay() {
                clearInterval(autoplayTimer);
                autoplayTimer = setInterval(() => step(1), AUTOPLAY_MS);
            }

            prevBtn.addEventListener('click', () => step(-1));
            nextBtn.addEventListener('click', () => step(1));
            dots.forEach((dot, i) => dot.addEventListener('click', () => goToReal(i)));

            window.addEventListener('resize', layout);
            layout();
            restartAutoplay();

            // Autoplay pausieren, während die Maus über dem Karussell steht
            carousel.addEventListener('mouseenter', () => clearInterval(autoplayTimer));
            carousel.addEventListener('mouseleave', restartAutoplay);

            // ---------- Teil 2: Diashow innerhalb jeder Kachel (Bilder überblenden) ----------
            const SLIDESHOW_INTERVAL_MS = 4000;

            document.querySelectorAll('.tile-slideshow').forEach(slideshow => {
                const tileSlides = Array.from(slideshow.children);
                if (tileSlides.length <= 1) return; // Nichts zu tun, wenn nur ein Bild vorhanden ist

                let current = 0;
                setInterval(() => {
                    tileSlides[current].classList.remove('is-active');
                    current = (current + 1) % tileSlides.length;
                    tileSlides[current].classList.add('is-active');
                }, SLIDESHOW_INTERVAL_MS);
            });
        })();
    </script>

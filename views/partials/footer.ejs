<script>
    // Has to be in main.js so you can call it from index.ejs page.

    // 1. Warenkorb aus dem LocalStorage laden (oder leeres Array erstellen)
    let cart = JSON.parse(localStorage.getItem('diyCart')) || [];

    // 2. Button oben rechts aktualisieren
    function updateCartCounter() {
        const count = cart.reduce((sum, item) => sum + item.quantity, 0);
        const cartBtn = document.getElementById('cartBtn');
        if (cartBtn) {
            cartBtn.innerText = `🛒 Warenkorb (${count})`;
        }
    }

        // 3. Produkt hinzufügen (aus index.ejs)
        function addToCart(id, name, price, imagePath, quantity = 1, variant = '') {
            const normalizedPrice = Number(price) || 0;
            const existingItem = cart.find(item => item.id === id && item.variant === variant);
            if (existingItem) {
                existingItem.quantity += parseInt(quantity); // Wenn schon drin, Anzahl + übergebene Menge
            } else { // Sonst neu anlegen
                cart.push({ 
                    id, 
                    name, 
                    price: normalizedPrice, 
                    quantity: parseInt(quantity), 
                    imagePath,
                    variant }); 
            }

        // JS-Array cart[] wird in string (JSON) umgewandelt und in localStorage gespeichert (nicht flüchtig)
        // kann durch JSON.parse() wieder in ein JS-Objekt umgewandelt werden.
        localStorage.setItem('diyCart', JSON.stringify(cart));
        updateCartCounter();
        alert(`${name} wurde zum Warenkorb hinzugefügt!`);
    }

    document.addEventListener('DOMContentLoaded', updateCartCounter);
</script>


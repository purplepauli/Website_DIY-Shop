<link rel="stylesheet" href="/css/dashboard/lists.css">
<script src="/js/dashboard/accounts.js" defer></script>

<% 
    const users = data ?? []; console.log(users);
    const _user = user ?? {}; console.log(_user);
%>

<div class="list-head">
    <h2 class="page-head__count" id="guideCountHeading">Es gibt <%= users.length == 1 ? "einen Account" : users.length + " Accounts"%></h2>
</div>
<div class="list" id="list-users">
    <% users.forEach(user => { %>
        <div class="list-row" data-id="<%= user.email %>">
            <div class="list-row-title"><%= user.name %> <%= user.surname %> - <%= user.email %></div>
            <div class="list-row-content">
                <div class="list-row-tags">
                    <% if(user.isAdmin) {%> <div class="list-row-tag-admin">Mitarbeiter</div><% } %>
                </div>
                <div class="list-row-actions">
                    <button type="button" class="btn btn--delete" data-action="delete" data-user='<%- JSON.stringify(_user).replace(/'/g, "&#39;") %>' data-id="<%= user.email %>" onclick="deleteUser(this)">Löschen</button>
                </div>
            </div>
        </div>
    <% }); %>
</div>

